+
+// Releases an allocation returned by aws_lc_nostd_alloc or
+// aws_lc_nostd_realloc. |size| and |align| equal the values used to create the
+// current allocation.
+void aws_lc_nostd_dealloc(void *ptr, size_t size, size_t align);
